########################################
# Commons: kitchen-api, worker, seed, venue-service
########################################

APP_ENV=dev
# debug | info | warn | error
LOG_LEVEL=info

# HTTP server address. In compose: 8081 for kitchen-api, 8080 for worker (only
# /healthz), 8082 for venue-service.
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_IDLE_TIMEOUT=60s
# How long graceful shutdown waits for active requests.
HTTP_SHUTDOWN_TIMEOUT=15s

POSTGRES_DSN=postgres://kitchen:kitchen@localhost:5432/kitchen?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_CONNECT_TIMEOUT=5s

KAFKA_BROKERS=localhost:9092
KAFKA_ORDERS_TOPIC=kitchen.orders.v1
KAFKA_STATUS_TOPIC=kitchen.order-status.v1
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TIMEOUT=10s

########################################
# kitchen-api
########################################

# How many status updates can accumulate for an SSE subscriber before its
# stream is closed: the client will reconnect and read missed events via Last-Event-ID.
SSE_BUFFER=16
# How often a heartbeat is sent to an idle stream.
SSE_HEARTBEAT=15s

# How long the response to an order placement attempt is stored, to return it
# to a retry with the same Idempotency-Key.
ORDERS_IDEMPOTENCY_TTL=24h

########################################
# worker: outbox job
########################################

OUTBOX_BATCH_SIZE=100
# Pause after an incomplete batch.
OUTBOX_POLL_MIN=50ms
# The longest pause on an empty table: this determines the event delivery latency.
OUTBOX_POLL_MAX=250ms

########################################
# worker: order-reaper job
########################################

# How long an order waits for the venue before the system automatically rejects it.
# In compose demo value is 30s, production value is 5m.
ORDER_ACCEPT_TIMEOUT=5m
ORDER_REAPER_INTERVAL=15s
ORDER_REAPER_BATCH_SIZE=50

########################################
# worker: courier job (delivery stub)
########################################

# How long an order takes to reach the customer before the platform closes it itself:
# courier logistics is not in MVP. In compose demo value is 5s.
ORDER_DELIVERY_DURATION=30m
ORDER_COURIER_INTERVAL=5s
ORDER_COURIER_BATCH_SIZE=50

########################################
# worker: idempotency-gc job
########################################

IDEMPOTENCY_GC_INTERVAL=10m
IDEMPOTENCY_GC_BATCH_SIZE=1000

########################################
# venue-service — demo venue (venue/)
########################################

# Its own venue database: the platform knows nothing about it.
# In compose: postgres://venue:venue@venue-postgres:5432/venue?sslmode=disable

# Partner API URL and key issued to the venue during onboarding.
PARTNER_BASE_URL=http://localhost:8081/api/v1
PARTNER_API_KEY=vk_demo_bakery_dev
PARTNER_TIMEOUT=10s

# Autopilot: a venue without a real chef manages orders via timers. Each delay
# is counted from the moment the order enters the current state.
AUTOPILOT_ENABLED=true
AUTOPILOT_INTERVAL=1s
AUTOPILOT_ACCEPT_AFTER=2s
AUTOPILOT_COOK_AFTER=2s
AUTOPILOT_READY_AFTER=5s
AUTOPILOT_HAND_AFTER=3s
AUTOPILOT_BATCH_SIZE=50

# Pause before retrying to upload the menu at startup: the first attempts
# are expected to fail, as the venue key appears on the platform only after seed.
BOOTSTRAP_RETRY=3s

########################################
# cmd/demo (make demo)
########################################

DEMO_BASE_URL=http://localhost:8081/api/v1
DEMO_HEALTH_URL=http://localhost:8081/healthz
DEMO_BAKERY_API_KEY=vk_demo_bakery_dev
DEMO_PIZZA_API_KEY=vk_demo_pizza_dev
DEMO_REQUEST_TIMEOUT=10s
# How long the demo waits for the stack to start up and for the bakery shift to open.
DEMO_STARTUP_WAIT=120s
# How long the demo waits for the entire order status lifecycle.
DEMO_STATUS_WAIT=120s
DEMO_POLL_INTERVAL=1s